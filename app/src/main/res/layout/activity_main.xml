<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Not yet Device Owner -->
        <LinearLayout
            android:id="@+id/notOwnerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KidLock is not the Device Owner yet."
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Temporarily sign out of every account on this phone (Settings &gt; Accounts). Nothing is deleted, and no factory reset is needed. Then enable USB debugging, connect to a computer, and run:" />

            <TextView
                android:id="@+id/adbCommand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Then reopen KidLock. You can sign back in to your accounts right away." />
        </LinearLayout>

        <!-- Kid launcher -->
        <LinearLayout
            android:id="@+id/launcherSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pick an app"
                android:textSize="24sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/launcherSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Search"
                android:inputType="text" />

            <com.quasslabs.kidlock.ExpandedGridView
                android:id="@+id/appGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnWidth="96dp"
                android:numColumns="auto_fit"
                android:stretchMode="columnWidth" />

            <TextView
                android:id="@+id/noAppsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No allowed apps are installed."
                android:visibility="gone" />

            <Button
                android:id="@+id/settingsButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Parent settings" />
        </LinearLayout>

        <!-- Parent settings -->
        <LinearLayout
            android:id="@+id/settingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Parent settings"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/openAppButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Open an app (Play Store, Settings, anything)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mode"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/modeTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total lockdown: no calls, no texts, no SIM. A streaming-only device." />

                <RadioButton
                    android:id="@+id/modeLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Light: still a working phone. Pinned sessions plus anti-tamper only." />
            </RadioGroup>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/debugSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Block developer options and USB debugging (turn off before installing updates)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Kid level"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How a child moves between allowed apps. The phone stays locked to the allowed apps at every level; only Hold for Done plus your PIN ends a session." />

            <RadioGroup
                android:id="@+id/kidLevelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/levelLittle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Little kid: one app per session. Changing apps needs your PIN." />

                <RadioButton
                    android:id="@+id/levelBig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Big kid: hold Switch app for 1 second to pick another allowed app." />

                <RadioButton
                    android:id="@+id/levelFree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Free: tap Switch app to pick another allowed app." />
            </RadioGroup>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/powerSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Power button opens Done: turning the screen off and on during a session shows Back to app and Done. Turn off to go straight back to the app; then Back is the only way to Done, and some games ignore it." />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/homeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="KidLock is the home screen: Home always comes back here, and the notification shade is blocked. Turn off to use the phone normally." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Allowed apps"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Skip Play Store, Chrome, and Settings: from inside them a child can reach everything else." />

            <EditText
                android:id="@+id/appSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search apps"
                android:inputType="text" />

            <LinearLayout
                android:id="@+id/appChecks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="PIN (leave blank to keep the current PIN)"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/pinField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="New PIN"
                android:inputType="numberPassword" />

            <EditText
                android:id="@+id/pinConfirmField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirm PIN"
                android:inputType="numberPassword" />

            <Button
                android:id="@+id/applyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Apply" />

            <Button
                android:id="@+id/removeOwnerButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Remove Device Owner" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
